[submodule "drivers/net/wireless/realtek/rtl8812au"]
	path = drivers/net/wireless/realtek/rtl8812au
	url = https://github.com/aircrack-ng/rtl8812au.git
[submodule "drivers/net/can/usb-can-2-module"]
	path = drivers/net/can/usb-can-2-module
